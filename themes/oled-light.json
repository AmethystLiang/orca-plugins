{
  "base": "light",
  "tokens": {
    "--background": "#ffffff",
    "--editor-surface": "#ffffff",
    "--foreground": "#191919",
    "--card": "#ffffff",
    "--card-foreground": "#191919",
    "--popover": "#ffffff",
    "--popover-foreground": "#191919",
    "--primary": "#191919",
    "--primary-foreground": "#ffffff",
    "--secondary": "#ebebeb",
    "--secondary-foreground": "#191919",
    "--muted": "#f0f0f0",
    "--muted-foreground": "#5c5c5c",
    "--accent": "#eeeeee",
    "--accent-foreground": "#0a0a0a",
    "--border": "#e0e0e0",
    "--input": "#d5d5d5",
    "--ring": "#737373",
    "--sidebar": "#ffffff",
    "--sidebar-foreground": "#191919",
    "--sidebar-primary": "#191919",
    "--sidebar-primary-foreground": "#ffffff",
    "--sidebar-accent": "#eeeeee",
    "--sidebar-accent-foreground": "#0a0a0a",
    "--sidebar-border": "#e0e0e0",
    "--sidebar-ring": "#737373",
    "--worktree-sidebar": "#ffffff",
    "--worktree-sidebar-foreground": "#191919",
    "--worktree-sidebar-accent": "#eeeeee",
    "--worktree-sidebar-accent-foreground": "#0a0a0a",
    "--worktree-sidebar-border": "#e0e0e0",
    "--worktree-sidebar-ring": "#737373"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#737373",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "variable.language"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#4c4c4c"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#1a7f37"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#8a6100"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#b35900"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#b35900"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#0969da"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#0f766e"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.parameter",
        "support.variable"
      ],
      "settings": {
        "foreground": "#191919"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#5c5c5c"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
    },
    {
      "name": "Attributes and keys",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#0f766e"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#8a6100"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#0969da",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#0f766e",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#737373",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#cf222e"
      }
    }
  ]
}
